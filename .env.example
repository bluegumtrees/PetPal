# ---- LLM / VLM via OpenRouter ----
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=openai/gpt-4o-mini
LLM_MODEL=openai/gpt-4o-mini

# ---- Maps (P5) ----
AMAP_KEY=

# ---- Email alerts (P6.2) ----
# 全部留空 → dry-run 模式（控制台打印邮件内容，db 标 channel=dry_run）
# 适合开发 / 演示。V2 才会真发到用户邮箱（届时加 user 表 + email 字段）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_TO=

# ---- App ----
APP_ENV=dev

# ---- Auth (V2) ----
# JWT 签名密钥。生产必须设一个随机长字符串（如 openssl rand -hex 32）
# 不设则用代码内 dev fallback（仅本地开发，切勿用于生产）
PETPAL_JWT_SECRET=

# ---- Dev mode (P6.2) ----
# 设为 1 才能用 /api/reminders/{id}/trigger_now 立即触发演示
# 生产部署一定要去掉或设 0
PETPAL_DEV_MODE=1

# ---- 构建/运行镜像源（可选，docker compose 读取） ----
# 默认全部走官方源，海外机房（Oracle Osaka 等）什么都不用填。
# 国内机房把下面几行取消注释：
# APT_MIRROR=mirrors.aliyun.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
# TORCH_INDEX_URL=https://mirrors.aliyun.com/pytorch-wheels/cpu
# NPM_REGISTRY=https://registry.npmmirror.com
# HF_ENDPOINT=https://hf-mirror.com
# 模型已进宿主 cache 后可设 1 强制离线（首次启动必须为 0 才能下载 BGE 模型）
# HF_HUB_OFFLINE=0
